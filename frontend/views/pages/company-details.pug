
extends ../layouts/default.pug

block title
    title Chi tiết công ty

block main
    //- Chi tiết công ty
    div(class="pt-[30px] pb-[60px]")
        .contain
            //- Thông tin công ty
            div(class="p-[20px] border border-[#DEDEDE] rounded-[8px]")
                div(class="flex flex-wrap gap-[16px] mb-[20px]")
                    img#company-logo(
                        src="assets/images/demo/demo4.png"
                        alt="Logo công ty"
                        class="w-[100px] rounded-[4px] object-contain"
                    )

                    div
                        div#company-name(class="font-[700] text-[28px] text-[#121212] mb-[10px]") Đang tải thông tin công ty...

                        div(class="font-[400] text-[14px] text-[#121212]")
                            i(class="fa-solid fa-location-dot text-[16px] mr-[4px]")
                            span#company-address Đang tải địa chỉ...

                div
                    div(class="flex gap-[4px] mb-[10px]")
                        div(class="font-[400] text-[16px] text-[#A6A6A6]") Mô hình công ty:
                        div#company-model(class="font-[400] text-[16px] text-[#121212]") Chưa cập nhật

                    div(class="flex gap-[4px] mb-[10px]")
                        div(class="font-[400] text-[16px] text-[#A6A6A6]") Quy mô công ty:
                        div#company-size(class="font-[400] text-[16px] text-[#121212]") Chưa cập nhật

                    div(class="flex gap-[4px] mb-[10px]")
                        div(class="font-[400] text-[16px] text-[#A6A6A6]") Thời gian làm việc:
                        div#company-working-time(class="font-[400] text-[16px] text-[#121212]") Chưa cập nhật

                    div(class="flex gap-[4px]")
                        div(class="font-[400] text-[16px] text-[#A6A6A6]") Làm việc ngoài giờ:
                        div#company-overtime-policy(class="font-[400] text-[16px] text-[#121212]") Chưa cập nhật
            //- Hết thông tin công ty

            //- Mô tả chi tiết
            div(class="border border-[#DEDEDE] rounded-[8px] p-[20px] mt-[20px]")
                p#company-description(class="whitespace-pre-line text-[#121212]") Đang tải mô tả công ty...
            //- Hết mô tả chi tiết

            //- Danh sách công việc của công ty
            div(class="mt-[30px]")
                h1#company-job-count(class="font-[700] text-[28px] text-[#121212] mb-[20px]") Đang tải công việc...

                div#company-job-list(class="grid lg:grid-cols-3 sm:grid-cols-2 grid-cols-1 gap-[20px]")
            //- Hết danh sách công việc

    //- Hết chi tiết công ty

block scripts
    script(src="assets/js/company-details.js")
