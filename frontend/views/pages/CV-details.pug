
extends ../layouts/default.pug

block title
    title Chi tiết CV (Nhà tuyển dụng)

block main
    div(class="py-[60px]")
        .contain
            div(class="border border-[#DEDEDE] rounded-[8px] p-[20px]")
                div(class="flex justify-between items-center mb-[20px]")
                    h1(class="font-bold text-[22px]") Thông tin CV
                    a(href="manage-CV.html" class="text-[#0088FF] underline") Quay lại danh sách

                p#cv-message(class="text-[#666] mb-[15px]") Đang tải thông tin...

                div(class="space-y-[12px]")
                    p Họ tên: 
                        span#candidate-name(class="font-semibold") —
                    p Email: 
                        span#candidate-email(class="font-semibold") —
                    p Số điện thoại: 
                        span#candidate-phone(class="font-semibold") —
                    p Trạng thái: 
                        span#application-status(class="font-semibold") —

                div(class="mt-[20px]")
                    h2(class="font-semibold mb-[10px]") File CV
                    iframe#cv-pdf(
                        title="Xem trước CV ứng viên"
                        class="hidden w-full h-[736px] border border-[#DEDEDE] rounded-[8px]"
                    )
                    a#cv-open(
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hidden text-[#0088FF] underline"
                    ) Mở CV trong tab mới
                    p#cv-empty(class="hidden") Chưa có file CV.

            div(class="border border-[#DEDEDE] rounded-[8px] p-[20px] mt-[20px]")
                h2(class="font-bold text-[20px] mb-[20px]") Thông tin công việc

                div(class="space-y-[12px]")
                    p Tên công việc: 
                        span#job-title(class="font-semibold") —
                    p Mức lương: 
                        span#job-salary(class="font-semibold") —
                    p Cấp bậc: 
                        span#job-level(class="font-semibold") —
                    p Hình thức làm việc: 
                        span#job-work-type(class="font-semibold") —

block scripts
    script(src="assets/js/CV-details.js")
