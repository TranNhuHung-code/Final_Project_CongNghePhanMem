extends ../layouts/default.pug

block title 
    title Quản lý CV đã gửi (Ứng viên)

block main
    div(class="py-[60px]")
        .contain
            h1(class="font-[700] text-[28px] text-[#121212] mb-[20px]")
                | Quản lý CV đã gửi

            p#applications-message(class="mb-[20px]")

            div(
                id="applications-container"
                class="grid lg:grid-cols-3 md:grid-cols-2 grid-cols-1 gap-[20px]"
            )
            div(class="mt-[30px]")
                        select(class="hidden border border-[#DEDEDE] rounded-[8px] py-[12px] px-[18px] font-[400] text-[16px] text-[#414042]")
                            option(value="") Trang 1 
                            option(value="") Trang 2
                            option(value="") Trang 3    
block scripts
    script(src="assets/js/applied-jobs.js")