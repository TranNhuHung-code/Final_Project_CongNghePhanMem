extends ../layouts/default.pug

block title 
    title Thông tin cá nhân (Ứng viên)

block main
    //- Thông tin cá nhân
    div(class="py-[60px]")
        .contain 
            div(class="border border-[#DEDEDE] rounded-[8px] p-[20px]")
                h1(class="font-[700] text-[20px] mb-[20px]") Thông tin cá nhân
                form(class="" id="candidateProfileForm") 
                    div(class="")
                        label(for="fullName" class="font-[500] text-[14px]") Họ tên *
                        input(type="text" id="fullName" class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] mt-[5px] mb-[15px] block w-full")

                    div(class="")
                        label(for="avatarFile" class="font-[500] text-[14px]") Avatar
                        <img id="avatarPreview" src="" class="w-[80px] h-[80px] object-cover rounded">
                        input(type="file" id="avatarFile" class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] mt-[5px] mb-[15px] block w-full")

                    div(class="grid md:grid-cols-2 grid-cols-1 md:gap-[20px] gap-[15px]")
                        div(class="")
                            label(for="email" class="font-[500] text-[14px]") Email *
                            input(type="email" id="email" class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] mt-[5px] mb-[15px] block w-full" readonly)
                        div(class="")
                            label(for="phone" class="font-[500] text-[14px]") Số điện thoại
                            input(type="text" id="phone" class="border border-[#DEDEDE] rounded-[4px] py-[11px] px-[20px] mt-[5px] mb-[15px] block w-full")

                    div(class="")
                        button(class="bg-[#0088FF] py-[14px] px-[20px] rounded-[4px] font-[700] text-[16px] text-white cursor-pointer") Cập nhật
    //- Hết Thông tin cá nhân
block scripts
    script(src="assets/js/candidate-profile.js")