extends ../layouts/default.pug

block title 
    title Danh sách công ty

block main
    //- Danh sách công ty
    div(class="py-[60px]")
        .contain
            h1(class="font-[700] sm:text-[28px] text-[24px] text-[#121212] text-center mb-[30px]") Danh sách công ty
            div(class="grid lg:grid-cols-3 grid-cols-2 sm:gap-x-[20px] gap-x-[10px] gap-y-[20px]")
                div(class="card-item")
                    img(src="assets/images/bg-card.png" class="inner-bg")
                    a(href="" class="inner-box") 
                        div(class="sm:pt-[32px] pt-[20px] sm:pb-[24px] pb-[16px] sm:px-[16px] px-[8px]")
                            div(class="inner-img sm:w-[160px] w-[125px]")
                                img(src="assets/images/demo/image1.png" class="")
                            h3(class="font-[700] sm:text-[18px] text-[14px] text-[#121212] text-center line-clamp-[2]") LG Electronics Development Vietnam (LGEDV)
                        div(class="bg-[#F7F7F7] py-[12px] sm:px-[16px] px-[6px] flex items-center justify-between sm:flex-row flex-col gap-[12px]")
                            div(class="font-[400] sm:text-[14px] text-[12px] text-[#414042]") Ho Chi Minh
                            div(class="font-[400] sm:text-[14px] text-[12px] text-[#121212]") 
                                <i class="fa-solid fa-user-tie text-[16px] mr-[6px] text-[#000096]"></i> 5 Việc làm

            div(class="mt-[30px]")
                select(class="border border-[#DEDEDE] rounded-[8px] px-[18px] py-[12px] font-[400] text-[16px] text-[#414042]") 
                    option(value="") Trang 1
                    option(value="") Trang 2
                    option(value="") Trang 3

    //- Hết Danh sách công ty