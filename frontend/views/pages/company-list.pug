extends ../layouts/default.pug

block title 
    title Danh sách công ty

block main
    //- Danh sách công ty
    div(class="py-[60px]")
        .contain
            h1(class="font-[700] sm:text-[28px] text-[24px] text-[#121212] text-center mb-[30px]") Danh sách công ty
            form#company-search-form(class="flex flex-wrap gap-[15px] mb-[30px]")
                input#company-search-keyword(
                    type="text"
                    placeholder="Nhập tên công ty..."
                    class="flex-1 min-w-[200px] h-[48px] border border-[#DEDEDE] rounded-[8px] px-[16px]"
                )

                select#company-search-city(
                    class="h-[48px] border border-[#DEDEDE] rounded-[8px] px-[16px] bg-white"
                )
                    option(value="") Tất cả thành phố
                    option(value="Hà Nội") Hà Nội
                    option(value="Đà Nẵng") Đà Nẵng
                    option(value="TP.HCM") TP.Hồ Chí Minh

                button(
                    type="submit"
                    class="h-[48px] bg-[#0088FF] text-white rounded-[8px] px-[24px] cursor-pointer"
                ) Tìm kiếm
            div#company-list(class="grid lg:grid-cols-3 grid-cols-2 sm:gap-x-[20px] gap-x-[10px] gap-y-[20px]")

            div(class="mt-[30px]")
                select(class="hidden border border-[#DEDEDE] rounded-[8px] px-[18px] py-[12px] font-[400] text-[16px] text-[#414042]") 
                    option(value="") Trang 1
                    option(value="") Trang 2
                    option(value="") Trang 3

    //- Hết Danh sách công ty
block scripts
    script(src="assets/js/company-list.js")