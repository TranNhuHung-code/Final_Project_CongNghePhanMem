extends ../layouts/default.pug

block title 
    title Quản lý công việc (Nhà tuyển dụng)

block main
    //- Quản lý công việc
    div(class="py-[60px]") 
        .contain 
            div(class="")
                div(class="flex flex-col sm:flex-row justify-between mb-[20px] gap-[20px]")
                    h1(class="font-[700] sm:text-[28px] text-[24px] text-[#121212]") Quản lý công việc
                    a(href="" class="bg-[#0088FF] rounded-[4px] py-[8px] px-[20px] font-[400] text-[14px] text-white flex items-center self-start sm:self-auto") Thêm mới 

                div(class="grid lg:grid-cols-3 md:grid-cols-2 grid-cols-1 gap-[20px]")
                    div(class="card-item p-[20px]")
                        img(src="assets/images/bg-card.png" class="inner-bg")
                        div(class="font-[700] text-[18px] text-[#121212] text-center line-clamp-[2]") Frontend Engineer (ReactJS)
                        div(class="font-[600] text-[16px] text-[#0088FF] text-center mt-[12px]") 1.000$ - 1.500$
                        div(class="font-[400] text-[14px] text-[#121212] text-center mt-[6px]") <i class="fa-solid fa-user-tie text-[16px] mr-[8px]"></i> Fresher
                        div(class="font-[400] text-[14px] text-[#121212] text-center mt-[6px]") <i class="fa-solid fa-briefcase text-[16px] mr-[8px]"></i> Tại văn phòng
   
                        div(class="mt-[12px] mb-[19px] flex justify-center items-center flex-wrap gap-[8px]") 
                            div(class="border border-[#DEDEDE] rounded-[20px] py-[6px] px-[16px] font-[400] text-[12px] text-[#414042]") ReactJS
                            div(class="border border-[#DEDEDE] rounded-[20px] py-[6px] px-[16px] font-[400] text-[12px] text-[#414042]") NextJS
                            div(class="border border-[#DEDEDE] rounded-[20px] py-[6px] px-[16px] font-[400] text-[12px] text-[#414042]") Javascript     
  
                        div(class="flex justify-center gap-[12px]")
                            button(class="bg-[#FFB200] rounded-[4px] py-[8px] px-[20px] font-[400] text-[14px] text-black") Sửa
                            button(class="bg-[#FF0000] rounded-[4px] py-[8px] px-[20px] font-[400] text-[14px] text-white") Xóa
    
                div(class="mt-[30px]")
                    select(class="border border-[#DEDEDE] rounded-[8px] py-[12px] px-[18px] font-[400] text-[16px] text-[#414042]")
                        option(value="") Trang 1 
                        option(value="") Trang 2
                        option(value="") Trang 3
    //- Hết Quản lý công việc