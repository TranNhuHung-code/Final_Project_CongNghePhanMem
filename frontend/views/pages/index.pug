extends ../layouts/default.pug

block title 
    title Trang chủ

block main
    //- Section 1
    include ../partials/section1.pug
    //- End Section 1

    //- Section 2
    div(class="py-[60px]")
        .contain
            h2(class="font-[700] sm:text-[28px] text-[24px] text-[#121212] text-center mb-[30px]") Nhà tuyển dụng hàng đầu
            div(class="grid lg:grid-cols-3 grid-cols-2 sm:gap-x-[20px] gap-y-[20px] gap-x-[10px]")
                div(class="card-item")
                    img(src="assets/images/bg-card.png" class="inner-bg")
                    a(href="" class="inner-box") 
                        div(class="sm:pt-[32px] pt-[20px] sm:pb-[24px] pb-[16px] sm:px-[16px] px-[8px]")
