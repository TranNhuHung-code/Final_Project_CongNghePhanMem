extends ../layouts/default.pug

block title 
    title Quản lý CV (Nhà tuyển dụng)

block main
    //- Quản lý CV
    div(class="py-[60px]") 
        .contain 
            div(class="")
                h1(class="font-[700] text-[28px] text-[#121212] mb-[20px]") Quản lý CV
                div(class="grid xl:grid-cols-3 lg:grid-cols-2 grid-cols-1 gap-[20px]")
                    div(class="card-item p-[20px]")
                        img(src="assets/images/bg-card.png" class="inner-bg")
                        div(class="font-[700] text-[18px] text-[#121212] text-center line-clamp-[2]") Frontend Engineer (ReactJS)
                        div(class="mt-[12px] font-[400] text-[14px] text-center") Ứng viên: <span class="font-[700] text-[14px]">Lê Văn A</span>
                        div(class="mt-[6px] font-[400] text-[14px] text-[#121212] text-center") <i class="fa-solid fa-envelope mr-[3px]"></i> levana@gmail.com
                        div(class="mt-[7px] font-[400] text-[14px] text-[#121212] text-center") <i class="fa-solid fa-phone mr-[3px]"></i> 0123456789
                        div(class="font-[600] text-[16px] text-[#0088FF] text-center mt-[12px]") 1.000$ - 1.500$
                        div(class="font-[400] text-[14px] text-[#121212] text-center mt-[6px]") <i class="fa-solid fa-user-tie text-[16px] mr-[1px]"></i> Fresher
                        div(class="font-[400] text-[14px] text-[#121212] text-center mt-[6px]") <i class="fa-solid fa-briefcase text-[16px] mr-[1px]"></i> Tại văn phòng
                        div(class="font-[400] text-[14px] text-[#FF0000] text-center mt-[6px]") <i class="fa-solid fa-eye text-[16px] mr-[1px]"></i> Chưa xem
                        div(class="font-[400] text-[14px] text-[#121212] text-center mt-[6px]") <i class="fa-solid fa-circle-check [16px] mr-[1px]"></i> Chưa duyệt
                        
                        div(class="flex flex-wrap justify-center gap-[8px] mt-[12px]")
                            button(class="bg-[#0088FF] rounded-[4px] py-[8px] px-[20px] cursor-pointer font-[400] text-[14px] text-white") Xem
                            button(class="bg-[#9FDB7C] rounded-[4px] py-[8px] px-[20px] cursor-pointer font-[400] text-[14px] text-black") Duyệt
                            button(class="bg-[#FF5100] rounded-[4px] py-[8px] px-[20px] cursor-pointer font-[400] text-[14px] text-white") Từ chối
                            button(class="bg-[#FF0000] rounded-[4px] py-[8px] px-[20px] cursor-pointer font-[400] text-[14px] text-white") Xóa

                div(class="mt-[30px]")
                    select(class="border border-[#DEDEDE] rounded-[8px] py-[12px] px-[18px] font-[400] text-[16px] text-[#414042]")
                        option(value="") Trang 1             
                        option(value="") Trang 2      
    //- Hết Quản lý CV