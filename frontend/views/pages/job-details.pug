extends ../layouts/default.pug

block title 
    title Chi tiết công việc

block main
    //- Chi tiết công việc
    div(class="pt-[30px] pb-[60px]")
        .contain 
            div(class="grid lg:grid-cols-[770fr_395fr] grid-cols-1 gap-[20px]")
                div(class="") 
                    //- Thông tin công việc
                    div(class="border border-[#DEDEDE] rounded-[8px] p-[20px]") 
                        h1#job-title(class="font-[700] sm:text-[28px] text-[24px] text-[#121212] mb-[10px]") Đang tải công việc...
                        div#job-company(class="font-[400] text-[16px] text-[#414042] mb-[10px]")
                        div#job-salary(class="font-[700] text-[20px] text-[#0088FF] mb-[20px]")
                        a(href="#boxApply" class="bg-[#0088FF] rounded-[4px] p-[14px] font-[700] text-[16px] text-white block text-center") Ứng tuyển

                        div#job-images(class="grid grid-cols-3 gap-[16px] mt-[20px]") 

                        div(class="mt-[20px]")
                            div(class="font-[400] text-[14px] text-[#121212]") <i class="fa-solid fa-user-tie text-[16px] mr-[8px]"></i> <span id="job-level"></span>
                            div(class="font-[400] text-[14px] text-[#121212] mt-[6px]") <i class="fa-solid fa-briefcase text-[16px] mr-[8px]"></i> <span id="job-work-type"></span>
                            div(class="font-[400] text-[14px] text-[#121212] mt-[6px]") <i class="fa-solid fa-location-dot text-[16px] mr-[8px]"></i> <span id="job-address"></span>
                        
                        div#job-technologies(class="flex flex-wrap gap-[8px] mt-[10px]")
                    //- Hết Thông tin công việc

                    //- Mô tả chi tiết
                    div(class="border border-[#DEDEDE] rounded-[8px] p-[20px] mt-[20px]") 
                        p#job-description(class="")
                    //- Hết Mô tả chi tiết
                    //- Form ứng tuyển
                    form#apply-form(class="grid gap-[15px]")
                        div
                            label(for="cvFile" class="font-[500] text-[14px]")
                                | File CV dạng PDF *

                            input#cvFile(
                                type="file"
                                accept=".pdf,application/pdf"
                                required
                                class="border border-[#DEDEDE] rounded-[4px] px-[20px] py-[12px] font-[500] text-[14px] text-black block w-full mt-[5px]"
                            )

                        p#apply-message(class="hidden")

                        div
                            button(
                                type="submit"
                                class="bg-[#0088FF] p-[14px] rounded-[4px] w-full font-[700] text-[16px] text-white text-center cursor-pointer"
                            ) Gửi CV ứng tuyển
                    //- Hết Form ứng tuyển
                div(class="") 
                    //- Thông tin công ty
                    div(class="p-[20px] border border-[#DEDEDE] rounded-[8px]")
                        div(class="flex gap-[12px] mb-[20px]")
                            img#company-logo(
                                src="assets/images/demo/demo4.png"
                                class="w-[100px] rounded-[4px]"
                                alt="Logo công ty"
                            )
                            div
                                div#company-name(
                                    class="font-[700] text-[18px] text-[#121212] mb-[10px]"
                                )
                                a(
                                    href="#"
                                    class="font-[400] text-[16px] text-[#0088FF]"
                                ) Xem công ty

                        div
                            div(class="flex justify-between mb-[10px]")
                                div(class="font-[400] text-[16px] text-[#A6A6A6]") Mô hình công ty
                                div#company-model(class="font-[400] text-[16px] text-[#121212]")

                            div(class="flex justify-between mb-[10px]")
                                div(class="font-[400] text-[16px] text-[#A6A6A6]") Quy mô công ty
                                div#company-size(class="font-[400] text-[16px] text-[#121212]")

                            div(class="flex justify-between mb-[10px]")
                                div(class="font-[400] text-[16px] text-[#A6A6A6]") Thời gian làm việc
                                div#company-working-time(class="font-[400] text-[16px] text-[#121212]")

                            div(class="flex justify-between")
                                div(class="font-[400] text-[16px] text-[#A6A6A6]") Làm việc ngoài giờ
                                div#company-overtime-policy(class="font-[400] text-[16px] text-[#121212]")

                    //- Hết Thông tin công ty

    //- Hết Chi tiết công việc
block scripts
    script(src="assets/js/job-details.js")
