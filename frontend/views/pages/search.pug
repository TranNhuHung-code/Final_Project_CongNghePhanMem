extends ../layouts/default.pug

block title 
    title Kết quả tìm kiếm

block main
    //- Section 1
    include ../partials/section1.pug
    //- End Section 1

    //- Kết quả tìm kiếm
    div(class="py-[60px]")
        .contain 
            h2#search-result-title(class="font-[700] text-[28px] text-[#121212] mb-[30px]") Đang tải công việc...
            div(class="rounded-[8px] bg-white py-[10px] px-[20px] flex flex-wrap gap-[12px]" style="box-shadow: 0px 4px 20px 0px #0000000F;")
                select#filter-level(class="border border-[#DEDEDE] rounded-[20px] py-[8px] px-[18px] font-[400] text-[16px] text-[#414042]") 
                    option(value="") Cấp bậc
                    option(value="Intern") Intern
                    option(value="Fresher") Fresher
                    option(value="Junior") Junior
                    option(value="Middle") Middle
                    option(value="Senior") Senior
                    option(value="Manager") Manager
                select#filter-work-type(class="border border-[#DEDEDE] rounded-[20px] py-[8px] px-[18px] font-[400] text-[16px] text-[#414042]")
                    option(value="") Hình thức làm việc 
                    option(value="Tại công ty") Tại công ty 
                    option(value="Từ xa") Từ xa 
                    option(value="Linh hoạt") Linh hoạt

            div#search-job-list(class="my-[30px] grid lg:grid-cols-3 sm:grid-cols-2 grid-cols-1 gap-[20px]") 

            select(class="hidden border border-[#DEDEDE] bg-white rounded-[8px] py-[12px] px-[18px] font-[400] text-[16px] text-[#414042]") 
                option(value="") Trang 1  
                option(value="") Trang 2  
                option(value="") Trang 3  
    //- Hết kết quả tìm kiếm
block scripts
    script(src="assets/js/search.js")
    script(src="assets/js/job-search.js")