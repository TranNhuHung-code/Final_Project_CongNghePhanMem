header(class="bg-[#000071] py-[15px]")
    .contain
        div(class="flex justify-between items-center")
            a(href="index.html" class="font-[800] sm:text-[28px] text-[20px] text-white lg:flex-none flex-1") VN.ITJobs

            nav#main-nav(class="menu hidden lg:block")
                ul
                    li
                        a(href="index.html#job-search") Việc Làm IT

                    li
                        a(href="company-list.html") Top Công Ty IT

                    li#candidate-menu(class="hidden")
                        a(href="#") Khu vực ứng viên
                        i(class="fa-solid fa-angle-down")
                        ul
                            li
                                a(href="applied-jobs.html") Đơn đã ứng tuyển
                            li
                                a(href="candidate-profile.html") Hồ sơ cá nhân

                    li#employer-menu(class="hidden")
                        a(href="#") Kênh nhà tuyển dụng
                        i(class="fa-solid fa-angle-down")
                        ul
                            li
                                a(href="manage-jobs.html") Quản lý công việc
                            li
                                a(href="create-jobs.html") Đăng tin tuyển dụng
                            li
                                a(href="manage-CV.html") Quản lý CV
                            li
                                a(href="company-profile.html") Thông tin công ty

            div#auth-actions(class="font-[600] sm:text-[16px] text-[12px] text-white flex items-center gap-[5px]")
                button#login-link(type="button" class="cursor-pointer") Đăng Nhập
                span#auth-divider /
                button#register-link(type="button" class="cursor-pointer") Đăng Ký
                button#logout-button(type="button" class="hidden cursor-pointer") Đăng Xuất

            button#mobile-menu-button(
                type="button"
                class="lg:hidden text-white text-[22px] ml-[12px]"
                aria-expanded="false"
                aria-controls="main-nav"
                aria-label="Mở menu"
            )
                i(class="fa-solid fa-bars")

    //- Hộp chọn loại tài khoản
    div#auth-role-modal(class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4")
        div(class="w-full max-w-[420px] rounded-[12px] bg-white p-[24px] shadow-lg")
            h2(class="font-[700] text-[24px] text-[#121212] text-center") Bạn là ai?

            p(class="mt-[8px] text-[14px] text-[#666] text-center") Chọn loại tài khoản để tiếp tục

            div(class="flex gap-[12px] mt-[24px]")
                button#auth-candidate(type="button" class="flex-1 rounded-[6px] bg-[#000071] py-[12px] text-white") Ứng viên

                button#auth-employer(type="button" class="flex-1 rounded-[6px] bg-[#0088FF] py-[12px] text-white") Nhà tuyển dụng

            button#auth-role-cancel(type="button" class="mt-[16px] w-full text-[#666] text-[14px]") Hủy